ATTIO_DISCOVERY_NICHE_ATTRIBUTE=
ATTIO_DISCOVERY_REGION_ATTRIBUTE=

CRM_INCLUDE_DEMO_LEADS=false
CRM_INCLUDE_DEMO_DATA=false
CRM_DB_PATH=

MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_IMAP_USE_SSL=true
