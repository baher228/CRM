# Non-secret local runtime configuration only. Configure provider secrets in
# Settings; CRM Workspace stores them in Windows Credential Manager.
CRM_ENV=development
CRM_DEV_CORS=true
CRM_SECURITY_BYPASS=true
CRM_PORT=8000
CRM_APP_ORIGIN=http://127.0.0.1:8000
CRM_DB_PATH=
CRM_DATA_DIR=
CRM_INCLUDE_DEMO_DATA=false
CRM_INCLUDE_DEMO_LEADS=false
CRM_ENABLE_DOCS=false

# Google Desktop OAuth public client configuration. Production uses an
# OS-assigned 127.0.0.1 callback port. Keep the fixed URI blank unless a local
# test environment needs the fallback API callback. The client secret is saved
# from Settings and never belongs in this file.
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional intelligence model selection (keys are entered in Settings).
GEMINI_MODEL=gemini-3.5-flash

# Deterministic local adapters for development and automated tests.
CRM_INTEGRATIONS_FAKE=false
CRM_DISCOVERY_FAKE=false
